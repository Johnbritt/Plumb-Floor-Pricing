# Login for the web app (HTTP Basic). Leave PLUMB_PASSWORD empty only on a private network.
PLUMB_USER=ops
PLUMB_PASSWORD=change-me
# Where the SQLite file lives. Put it on a persistent disk.
PLUMB_DB=./var/plumb.db
# Load the synthetic demo data when the database is empty (1) or start empty (0).
PLUMB_SEED_DEMO=1
# Agent backend: heuristic (offline keyword rules, default) or claude (needs ANTHROPIC_API_KEY).
PLUMB_AGENT=heuristic
ANTHROPIC_API_KEY=
PLUMB_MODEL=claude-sonnet-5-5
# Optional JSON to override the gate parameters, for example {"thinV": 3000}
PLUMB_PARAMS=
